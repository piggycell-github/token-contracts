# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Owner wallet address that will own the staking contract
OWNER_WALLET=0xYourOwnerWalletAddress

# PIGGY token contract address (proxy address)
PIGGY_TOKEN_ADDRESS=0xYourPiggyTokenProxyAddress

# BSCScan API key for contract verification
BSC_API_KEY=your_bscscan_api_key

# Gas reporting (optional)
REPORT_GAS=false
